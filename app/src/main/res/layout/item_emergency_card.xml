<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">

    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:realtimeBlurRadius="30dp"
        app:realtimeOverlayColor="#26FF3B30" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_glass_card"
        android:padding="24dp">

        <View
            android:id="@+id/pulse_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_stock_badge"
            android:backgroundTint="#FF3B30"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_medicine_name"
            app:layout_constraintBottom_toBottomOf="@id/text_medicine_name" />

        <TextView
            android:id="@+id/text_medicine_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/text_status"
            app:layout_constraintStart_toEndOf="@id/pulse_indicator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Anti-Snake Venom" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cyber_pill"
            android:backgroundTint="#4D34C759"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="STABLE"
            android:textColor="#1B5E20"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_generic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4A148C"
            android:textSize="14sp"
            android:alpha="0.7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/text_medicine_name"
            app:layout_constraintTop_toBottomOf="@id/text_medicine_name"
            tools:text="Polyvalent ASV" />

        <TextView
            android:id="@+id/text_shop_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/text_stock"
            app:layout_constraintStart_toStartOf="@id/text_medicine_name"
            app:layout_constraintTop_toBottomOf="@id/text_generic"
            tools:text="📍 Sanjeevini Medicals" />

        <TextView
            android:id="@+id/text_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF3B30"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/text_shop_info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_shop_info"
            tools:text="Qty: 5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
