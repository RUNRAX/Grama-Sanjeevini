<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:realtimeBlurRadius="30dp"
        app:realtimeOverlayColor="#33FFFFFF" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_glass_card"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_medicine_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_minus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Paracetamol 500mg" />

        <TextView
            android:id="@+id/text_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#7B1FA2"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btn_minus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_medicine_name"
            tools:text="OTC" />

        <!-- Stock Status Visual -->
        <View
            android:id="@+id/stock_status_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_stock_badge"
            android:backgroundTint="#34C759"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_category" />

        <TextView
            android:id="@+id/text_demand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="High Demand 🔥"
            android:textColor="#4A148C"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/stock_status_dot"
            app:layout_constraintStart_toEndOf="@id/stock_status_dot"
            app:layout_constraintTop_toTopOf="@id/stock_status_dot" />

        <!-- Cyber Controls -->
        <ImageButton
            android:id="@+id/btn_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cyber_pill"
            android:backgroundTint="#26000000"
            android:src="@drawable/ic_remove"
            app:tint="#000000"
            android:padding="10dp"
            android:contentDescription="Dec"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/text_stock_count"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_stock_count"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_minus"
            app:layout_constraintEnd_toStartOf="@id/btn_plus"
            app:layout_constraintTop_toTopOf="@id/btn_minus"
            tools:text="80" />

        <ImageButton
            android:id="@+id/btn_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cyber_pill"
            android:backgroundTint="#26000000"
            android:src="@drawable/ic_add"
            app:tint="#000000"
            android:padding="10dp"
            android:contentDescription="Inc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
